{
  "version": 1,
  "comp": { "name": "Colors and holds", "width": 400, "height": 400, "duration": 3, "frameRate": 30, "background": [0.07, 0.07, 0.09] },
  "layers": [
    {
      "id": 1, "name": "Signal", "type": "shape",
      "transform": {
        "position": { "separated": true,
          "x": { "keyframes": [
            { "t": 0, "v": 120, "easeOut": [{ "speed": 0, "influence": 33.333 }] },
            { "t": 3, "v": 280, "easeIn": [{ "speed": 0, "influence": 33.333 }] }
          ] },
          "y": 200 }
      },
      "contents": [
        { "type": "group", "name": "Light",
          "transform": {
            "rotation": { "keyframes": [
              { "t": 0, "v": 0, "outType": "hold" },
              { "t": 1, "v": 45, "easeOut": [{ "speed": 0, "influence": 33.333 }] },
              { "t": 2, "v": 180, "easeIn": [{ "speed": 0, "influence": 33.333 }] }
            ] }
          },
          "contents": [
            { "type": "rect", "size": [120, 120], "position": [0, 0], "roundness": 24 },
            { "type": "stroke", "color": [1, 1, 1, 1], "opacity": 60,
              "width": { "keyframes": [{ "t": 0, "v": 4 }, { "t": 1.5, "v": 14 }, { "t": 3, "v": 4 }] } },
            { "type": "fill", "opacity": 100,
              "color": { "keyframes": [
                { "t": 0, "v": [0.95, 0.25, 0.25, 1], "outType": "hold" },
                { "t": 1, "v": [0.25, 0.85, 0.4, 1], "outType": "hold" },
                { "t": 2, "v": [0.3, 0.5, 1, 1] }
              ] } }
          ]
        }
      ]
    }
  ]
}
