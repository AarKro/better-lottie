{
  "version": 1,
  "comp": { "name": "Baked motion", "width": 400, "height": 400, "duration": 2, "frameRate": 30, "background": [0.07, 0.07, 0.09] },
  "layers": [
    {
      "id": 1, "name": "Label", "type": "text",
      "transform": { "position": [200, 60] }
    },
    {
      "id": 2, "name": "Ball", "type": "shape",
      "transform": {
        "position": { "keyframes": [
          { "t": 0, "v": [80, 320, 0], "spatialOut": [60, -260, 0], "easeOut": [{ "speed": 0, "influence": 33.333 }] },
          { "t": 1.6, "v": [320, 320, 0], "spatialIn": [-60, -260, 0], "easeIn": [{ "speed": 0, "influence": 33.333 }] }
        ] },
        "scale": { "keyframes": [
          { "t": 0, "v": [0, 0], "easeOut": [{ "speed": 0, "influence": 33.333 }, { "speed": 0, "influence": 33.333 }] },
          { "t": 0.6, "v": [100, 100], "easeIn": [{ "speed": -300, "influence": 50 }, { "speed": -300, "influence": 50 }] }
        ] }
      },
      "contents": [
        { "type": "ellipse", "size": [50, 50], "position": [0, 0] },
        { "type": "fill", "color": [0.4, 0.9, 0.7, 1] },
        { "type": "trim", "name": "Trim Paths 1", "start": 0, "end": 50 }
      ]
    }
  ]
}
