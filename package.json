{
  "name": "better-lottie",
  "version": "0.2.0",
  "description": "Export After Effects shape animations as self-animating SVG (SMIL) files.",
  "type": "module",
  "bin": {
    "better-lottie": "bin/better-lottie.js"
  },
  "scripts": {
    "build": "esbuild src/index.js --bundle --format=iife --global-name=BetterLottieSVG --target=chrome61 --outfile=extension/lib/better-lottie.js",
    "test": "node --test \"test/*.test.js\"",
    "test:update": "UPDATE_SNAPSHOTS=1 node --test \"test/*.test.js\"",
    "preview": "node scripts/build-preview.js",
    "dev:install": "npm run build && node scripts/install-dev.js",
    "dev:uninstall": "node scripts/install-dev.js --uninstall"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "acorn": "^8.19.0",
    "esbuild": "^0.28.2"
  }
}
